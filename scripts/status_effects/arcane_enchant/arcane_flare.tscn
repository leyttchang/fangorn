[sub_resource type="Shader" id="Shader_orb_core"]
code = "shader_type spatial;
render_mode unshaded, blend_add, cull_back, depth_draw_never;

uniform vec4 core_color : source_color = vec4(0.96, 0.86, 1.0, 1.0);
uniform vec4 halo_color : source_color = vec4(0.56, 0.15, 1.0, 1.0);
uniform float emission_boost : hint_range(0.5, 6.0) = 2.45;
uniform float pulse_speed : hint_range(0.0, 10.0) = 4.2;

varying float v_cam_fade;
varying vec3 v_obj_nrm;

void vertex() {
	v_obj_nrm = NORMAL;
	float pulse = 1.0 + 0.06 * sin(TIME * pulse_speed);
	float cam_dist = length(CAMERA_POSITION_WORLD - NODE_POSITION_WORLD);
	// Borne la taille écran à courte portée pour empêcher tout overdraw plein écran 1080p
	float near_scale = clamp(cam_dist / 1.35, 0.18, 1.0);
	VERTEX *= pulse * near_scale;
	v_cam_fade = mix(0.25, 1.0, smoothstep(0.30, 1.35, cam_dist));
}

void fragment() {
	float ndotv = clamp(dot(NORMAL, VIEW), 0.0, 1.0);
	float swirl = 0.88 + 0.22 * sin(v_obj_nrm.x * 7.5 + TIME * 6.2) * cos(v_obj_nrm.y * 6.5 - TIME * 4.8);
	float outer_halo = pow(ndotv, 0.90) * 0.52 * swirl;
	float center_glow = pow(ndotv, 2.8);
	float rim_glow = pow(1.0 - ndotv, 1.8) * ndotv * 2.1 * swirl;
	float pulse = 0.92 + 0.10 * sin(TIME * pulse_speed * 1.25);
	vec3 halo_hdr = halo_color.rgb * 2.35;
	vec3 core_hdr = core_color.rgb * (emission_boost * 1.15);
	vec3 col = mix(halo_hdr, core_hdr, center_glow);
	ALBEDO = col * pulse;
	ALPHA = clamp((outer_halo + center_glow * 0.90 + rim_glow * 0.65) * v_cam_fade, 0.0, 1.0);
}
"

