[sub_resource type="Shader" id="Shader_orb_core"]
code = "shader_type spatial;
render_mode unshaded, blend_add, cull_back, depth_draw_never;

uniform vec4 core_color : source_color = vec4(0.96, 0.86, 1.0, 1.0);
uniform vec4 halo_color : source_color = vec4(0.55, 0.14, 1.0, 1.0);
uniform float emission_boost : hint_range(0.5, 6.0) = 2.55;
uniform float pulse_speed : hint_range(0.0, 10.0) = 4.2;

void vertex() {
	float pulse = 1.0 + 0.065 * sin(TIME * pulse_speed);
	VERTEX *= pulse;
}

void fragment() {
	float ndotv = clamp(dot(NORMAL, VIEW), 0.0, 1.0);
	float center_glow = pow(ndotv, 2.3);
	float rim_glow = pow(1.0 - ndotv, 1.9) * ndotv * 2.6;
	float pulse = 0.92 + 0.12 * sin(TIME * pulse_speed * 1.25);
	vec3 halo_hdr = vec3(1.4, 0.35, 2.6);
	vec3 core_hdr = core_color.rgb * (emission_boost * 1.15);
	vec3 col = mix(halo_hdr, core_hdr, center_glow);
	ALBEDO = col * pulse;
	ALPHA = clamp(center_glow * 0.95 + rim_glow * 0.78, 0.0, 1.0);
}
"

