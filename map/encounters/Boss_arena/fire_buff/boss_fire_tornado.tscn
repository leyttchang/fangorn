[sub_resource type="Shader" id="Shader_fire_funnel"]
code = "shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled;

uniform sampler2D fire_tex : source_color, filter_linear_mipmap, repeat_enable;
uniform float cylinder_height = 4.3;
uniform float twist_turns = 1.85;
uniform float spin_speed = 4.8;
uniform float wobble_amount = 0.16;
uniform vec2 scroll_speed = vec2(0.88, 1.52);
uniform vec4 color_core : source_color = vec4(1.0, 0.93, 0.44, 1.0);
uniform vec4 color_mid : source_color = vec4(1.0, 0.46, 0.06, 1.0);
uniform vec4 color_outer : source_color = vec4(0.92, 0.15, 0.02, 1.0);
uniform float hdr_intensity = 2.25;
uniform float opacity : hint_range(0.0, 1.0) = 1.0;
uniform float phase_offset = 0.0;

varying float v_height;

void vertex() {
	float h = clamp((VERTEX.y + cylinder_height * 0.5) / max(cylinder_height, 0.01), 0.0, 1.0);
	v_height = h;
	float t = TIME * spin_speed + phase_offset;
	float twist_angle = h * twist_turns * 6.2831853 - t;
	float c = cos(twist_angle * 0.36);
	float s = sin(twist_angle * 0.36);
	vec2 xz = vec2(VERTEX.x, VERTEX.z);
	xz = vec2(xz.x * c - xz.y * s, xz.x * s + xz.y * c);
	float sway = wobble_amount * (0.18 + 0.82 * h);
	xz.x += sin(h * 8.6 - t * 1.3) * sway;
	xz.y += cos(h * 8.6 - t * 1.3) * sway;
	float breath = 1.0 + 0.07 * sin(h * 11.5 - t * 2.0);
	VERTEX.x = xz.x * breath;
	VERTEX.z = xz.y * breath;
}

void fragment() {
	float t = TIME + phase_offset * 0.41;
	vec2 uv_a = vec2(UV.x * 2.0 + v_height * 1.4 - t * scroll_speed.x, v_height * 1.5 - t * scroll_speed.y);
	vec2 uv_b = vec2(UV.x * 3.0 - v_height * 1.75 + t * (scroll_speed.x * 0.72) + 0.5, v_height * 2.15 - t * (scroll_speed.y * 1.24) + 0.5);
	vec4 tex_a = texture(fire_tex, uv_a);
	vec4 tex_b = texture(fire_tex, uv_b);
	float val_a = max(tex_a.r, max(tex_a.g, tex_a.b)) * tex_a.a;
	float val_b = max(tex_b.r, max(tex_b.g, tex_b.b)) * tex_b.a;
	float tex_energy = max(val_a, val_b * 0.88);

	float band_1 = 0.5 + 0.5 * sin((UV.x * 3.0 + v_height * 1.65 - t * scroll_speed.x * 0.95) * 6.2831853);
	float band_2 = 0.5 + 0.5 * sin((UV.x * 5.0 - v_height * 2.35 - t * scroll_speed.x * 1.35) * 6.2831853);
	float spiral_ribbons = pow(band_1 * 0.68 + band_2 * 0.32, 1.35);

	float flame = clamp(tex_energy * 0.72 + spiral_ribbons * 0.68, 0.0, 1.35);
	float bottom_fade = smoothstep(0.0, 0.09, v_height);
	float top_fade = 1.0 - smoothstep(0.66, 1.0, v_height + (1.0 - spiral_ribbons) * 0.24);
	float view_facing = 0.36 + 0.64 * abs(dot(normalize(NORMAL), normalize(VIEW)));
	float mask = clamp(flame * bottom_fade * top_fade * view_facing, 0.0, 1.0);

	vec3 col = mix(color_outer.rgb, color_mid.rgb, smoothstep(0.18, 0.62, flame));
	col = mix(col, color_core.rgb, smoothstep(0.62, 1.05, flame) * (1.0 - v_height * 0.32));

	ALBEDO = col * hdr_intensity;
	ALPHA = clamp(mask * opacity, 0.0, 1.0);
}
"

